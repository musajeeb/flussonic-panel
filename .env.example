# ─────────────────────────────────────────────────────────────
#  Flussonic CRM — configuration
#  Copy this file to `.env` and edit the values.
# ─────────────────────────────────────────────────────────────

# Port the whole panel runs on (front-end + API together)
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
# mongo  = normal operation (data is saved)
# memory = try the panel with no database installed (data is lost on restart)
DB_DRIVER=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/flussonic-crm
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/flussonic-crm

# ── Panel login ──────────────────────────────────────────────
# Created automatically on first start. Changing it later has no effect —
# use Settings → Change password inside the panel instead.
ADMIN_EMAIL=sajeeb809@live.com
ADMIN_PASSWORD=musajeeb

# ── Secrets — CHANGE ALL THREE BEFORE GOING LIVE ─────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=7d

# Encrypts the Flussonic admin passwords stored in the database.
# If you change this after adding servers, you must re-enter their passwords.
ENCRYPTION_KEY=change-this-to-a-different-long-random-string

# Flussonic must send this key when it asks the panel to authorize a viewer.
AUTH_BACKEND_KEY=change-this-too

# ── Public address ───────────────────────────────────────────
# The URL your Flussonic servers and customers use to reach this panel.
# Leave blank for localhost testing.
PUBLIC_URL=

# Comma-separated list, or blank to allow all origins.
CORS_ORIGIN=

# ── Monitoring ───────────────────────────────────────────────
MONITOR_ENABLED=true
MONITOR_INTERVAL_SEC=60
FLUSSONIC_TIMEOUT_MS=8000
LOG_REQUESTS=true
